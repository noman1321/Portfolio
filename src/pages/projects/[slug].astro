---
import Layout from "../../layouts/Layout.astro";
import ArchitectureDiagram from "../../components/ArchitectureDiagram.astro";
import { siteConfig } from "../../config";

export function getStaticPaths() {
  return siteConfig.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const flow = ["Problem", "Solution", "Architecture", "Technology", "Impact"];
---

<Layout title={project.name} description={project.tagline}>
  <article class="pt-28 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <a href="/projects" class="font-mono text-xs text-white/40 hover:text-cyan-300">← All projects</a>
      <p class="section-kicker mt-6">{project.domains.join(" · ")}</p>
      <h1 class="font-display text-4xl sm:text-5xl mt-3">{project.name}</h1>
      <p class="mt-4 text-lg text-white/70">{project.tagline}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {project.demo && <a href={project.demo} class="btn-primary !py-2" target="_blank" rel="noopener noreferrer">Play Store</a>}
        {project.github && <a href={project.github} class="btn-ghost !py-2" target="_blank" rel="noopener noreferrer">GitHub</a>}
        <a href="/case-studies" class="btn-ghost !py-2">Related thinking</a>
      </div>

      <div class="mt-10 flex flex-wrap gap-2">
        {flow.map((item, i) => (
          <span class="font-mono text-[11px] text-white/50">
            {item}{i < flow.length - 1 ? " →" : ""}
          </span>
        ))}
      </div>

      <section class="mt-12 space-y-10">
        <div>
          <h2 class="font-display text-2xl">Overview</h2>
          <p class="mt-3 text-white/70 leading-relaxed">{project.overview}</p>
        </div>
        <div>
          <h2 class="font-display text-2xl">The Problem</h2>
          <p class="mt-3 text-white/70 leading-relaxed">{project.problem}</p>
        </div>
        <div>
          <h2 class="font-display text-2xl">What I Built</h2>
          <ul class="mt-3 space-y-2">
            {project.whatIBuilt.map((item) => <li class="text-white/70">→ {item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-2xl">How It Works</h2>
          <ol class="mt-3 space-y-2 list-decimal pl-5">
            {project.howItWorks.map((item) => <li class="text-white/70">{item}</li>)}
          </ol>
        </div>
      </section>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 mt-14">
      <h2 class="font-display text-2xl mb-4">Architecture</h2>
      <ArchitectureDiagram title={project.architecture.title} layers={project.architecture.layers} />
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 mt-14 space-y-10">
      <div>
        <h2 class="font-display text-2xl">Technical Decisions</h2>
        <div class="mt-4 space-y-3">
          {project.technicalDecisions.map((item) => (
            <div class="glass rounded-xl p-4">
              <h3 class="text-white">{item.title}</h3>
              <p class="mt-2 text-sm text-white/65">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
      {project.aiWorkflow && project.aiWorkflow.length > 0 && (
        <div>
          <h2 class="font-display text-2xl">AI / LLM Workflow</h2>
          <ol class="mt-3 space-y-2">
            {project.aiWorkflow.map((item, i) => (
              <li class="text-white/70 font-mono text-sm">{String(i + 1).padStart(2, "0")} — {item}</li>
            ))}
          </ol>
        </div>
      )}
      <div>
        <h2 class="font-display text-2xl">Challenges</h2>
        {project.challenges.map((item) => (
          <div class="mt-4 grid grid-cols-1 gap-3">
            <div class="rounded-xl border border-white/10 p-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-white/40">Challenge</p>
              <p class="mt-2 text-white/75">{item.challenge}</p>
            </div>
            <div class="rounded-xl border border-white/10 p-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-white/40">Decision</p>
              <p class="mt-2 text-white/75">{item.decision}</p>
            </div>
            <div class="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-cyan-300">Result</p>
              <p class="mt-2 text-white/75">{item.result}</p>
            </div>
          </div>
        ))}
      </div>
      <div>
        <h2 class="font-display text-2xl">What I Learned</h2>
        <ul class="mt-3 space-y-2">
          {project.learned.map((item) => <li class="text-white/70">→ {item}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-display text-2xl">Impact</h2>
        <ul class="mt-3 space-y-2">
          {project.impact.map((item) => <li class="text-white/70">→ {item}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-display text-2xl">Technology</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {project.skills.map((skill) => (
            <span class="font-mono text-xs px-3 py-1.5 rounded-md border border-white/10">{skill}</span>
          ))}
        </div>
      </div>
      {project.demo && (
        <div>
          <h2 class="font-display text-2xl">Live</h2>
          <a href={project.demo} class="mt-3 inline-flex text-cyan-300 hover:underline" target="_blank" rel="noopener noreferrer">
            {project.demo}
          </a>
        </div>
      )}
      {project.github && (
        <div>
          <h2 class="font-display text-2xl">GitHub</h2>
          <a href={project.github} class="mt-3 inline-flex text-cyan-300 hover:underline" target="_blank" rel="noopener noreferrer">
            {project.github}
          </a>
        </div>
      )}
    </div>
  </article>
</Layout>
