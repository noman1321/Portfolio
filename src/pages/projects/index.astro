---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { siteConfig } from "../../config";
---

<Layout title="Projects" description="Flagship AI systems: agents, LLM applications, and applied AI products.">
  <section class="pt-28 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="section-kicker">Projects</p>
      <h1 class="font-display text-4xl sm:text-5xl mt-3">AI systems, not project lists</h1>
      <p class="mt-4 text-white/60 max-w-2xl">
        Three flagship builds. Each one is a full case study: problem, architecture, technical decisions, and what I learned.
      </p>
      <div class="mt-10 grid grid-cols-1 gap-4">
        {siteConfig.projects.map((project, index) => (
          <ProjectCard
            slug={project.slug}
            name={project.name}
            tagline={project.tagline}
            domains={project.domains}
            problem={project.problem}
            solution={project.solution}
            github={project.github}
            index={index}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
