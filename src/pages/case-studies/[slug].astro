---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config";

export function getStaticPaths() {
  return siteConfig.caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
---

<Layout title={study.title} description={study.summary}>
  <article class="pt-28 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <a href="/case-studies" class="font-mono text-xs text-white/40 hover:text-cyan-300">← All case studies</a>
      <p class="section-kicker mt-6">Case Study {study.number}</p>
      <h1 class="font-display text-4xl sm:text-5xl mt-3">{study.title}</h1>
      <p class="mt-4 text-lg text-white/70">{study.summary}</p>
      <div class="mt-5 flex flex-wrap gap-1.5">
        {study.tags.map((tag) => (
          <span class="font-mono text-[10px] uppercase tracking-wide px-2 py-1 rounded-md border border-white/10 text-white/60">{tag}</span>
        ))}
      </div>

      <div class="mt-10 overflow-x-auto">
        <div class="flex flex-col gap-1 min-w-[240px]">
          {study.pipeline.map((step, index) => (
            <div class="flex flex-col items-start">
              <div class="glass rounded-lg px-3 py-2 text-sm text-white/80 w-full">{step}</div>
              {index < study.pipeline.length - 1 && <span class="font-mono text-cyan-400/70 px-3 py-1">↓</span>}
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 space-y-8 text-white/75 leading-relaxed">
        <section>
          <h2 class="font-display text-2xl text-white">Context</h2>
          <p class="mt-3">{study.context}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Business Problem</h2>
          <p class="mt-3">{study.businessProblem}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Requirements</h2>
          <ul class="mt-3 space-y-2">
            {study.requirements.map((item) => <li>→ {item}</li>)}
          </ul>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">AI Architecture</h2>
          <p class="mt-3">{study.architecture}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Model Selection</h2>
          <p class="mt-3">{study.modelSelection}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">RAG / Agent Design</h2>
          <p class="mt-3">{study.ragOrAgent}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Integration</h2>
          <p class="mt-3">{study.integration}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Deployment</h2>
          <p class="mt-3">{study.deployment}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Monitoring</h2>
          <p class="mt-3">{study.monitoring}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl text-white">Iteration</h2>
          <p class="mt-3">{study.iteration}</p>
        </section>
        <section class="rounded-2xl border border-cyan-400/20 bg-cyan-400/5 p-6 space-y-4">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-cyan-300">Challenge</p>
            <p class="mt-2">{study.challenge.challenge}</p>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-cyan-300">Decision</p>
            <p class="mt-2">{study.challenge.decision}</p>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-cyan-300">Result</p>
            <p class="mt-2">{study.challenge.result}</p>
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>
