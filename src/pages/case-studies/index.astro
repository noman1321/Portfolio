---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config";
---

<Layout title="Case Studies" description="How Noman thinks about enterprise AI, RAG, agents, and shipping to production.">
  <section class="pt-28 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="section-kicker">Case studies</p>
      <h1 class="font-display text-4xl sm:text-5xl mt-3">How I think, not just what I built</h1>
      <p class="mt-4 text-white/60 max-w-2xl">
        Forward deployed AI work is mostly translation: a messy business problem into a system that can be deployed, measured, and iterated.
      </p>
      <div class="mt-10 grid grid-cols-1 gap-4">
        {siteConfig.caseStudies.map((study) => (
          <a href={`/case-studies/${study.slug}`} class="glass glass-hover rounded-2xl p-6 block">
            <p class="font-mono text-[11px] text-cyan-300">Case Study {study.number}</p>
            <h2 class="font-display text-2xl text-white mt-2">{study.title}</h2>
            <p class="mt-3 text-white/60">{study.summary}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {study.tags.map((tag) => (
                <span class="font-mono text-[10px] uppercase tracking-wide px-2 py-1 rounded-md border border-white/10 text-white/60">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
