---
import { siteConfig } from "../config";
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <p class="section-kicker">Beyond the resume</p>
    <h2 class="font-display text-3xl sm:text-4xl mt-3 mb-8">What I'm currently exploring</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
      {siteConfig.exploring.map((item) => (
        <div class="glass rounded-xl px-4 py-3 text-sm text-white/80">
          <span class="text-cyan-300 mr-2">◉</span>{item}
        </div>
      ))}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {siteConfig.careerTimeline.map((item) => (
        <div class="rounded-xl border border-white/10 p-4">
          <p class="font-mono text-cyan-300 text-sm">{item.year}</p>
          <p class="mt-2 text-white">{item.label}</p>
          <p class="mt-1 text-sm text-white/50">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
