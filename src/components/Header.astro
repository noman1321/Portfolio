---
import { siteConfig } from "../config";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home", match: (p: string) => p === "/" },
  { href: "/about", label: "About", match: (p: string) => p.startsWith("/about") },
  { href: "/projects", label: "Projects", match: (p: string) => p.startsWith("/projects") },
  { href: "/case-studies", label: "Case Studies", match: (p: string) => p.startsWith("/case-studies") },
  { href: "/lab", label: "Lab", match: (p: string) => p.startsWith("/lab") },
  { href: "/contact", label: "Contact", match: (p: string) => p.startsWith("/contact") },
];
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
    <div class="glass rounded-xl px-3 sm:px-4 py-2.5 flex items-center justify-between gap-3">
      <a href="/" class="flex items-center gap-2 min-w-0">
        <span class="font-mono text-[11px] text-cyan-300/90 tracking-[0.18em] uppercase">AN</span>
        <span class="hidden sm:inline text-sm text-white/80 truncate">{siteConfig.name}</span>
      </a>

      <div class="flex items-center gap-2">
        <ul id="nav-menu" class="hidden md:flex items-center gap-1">
          {links.map((link) => {
            const active = link.match(path);
            return (
              <li>
                <a
                  href={link.href}
                  class={`px-2.5 py-1.5 rounded-md text-[13px] font-medium transition-colors ${
                    active ? "text-cyan-300 bg-cyan-400/10" : "text-white/70 hover:text-white"
                  }`}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
          <li>
            <button type="button" class="theme-toggle hidden md:inline-flex" data-theme-toggle aria-label="Toggle light and dark mode">
              <svg class="theme-icon-dark w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
              </svg>
              <svg class="theme-icon-light w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36 6.36l-1.42-1.42M7.05 7.05L5.64 5.64m12.72 0l-1.41 1.41M7.05 16.95l-1.41 1.41M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
              </svg>
            </button>
          </li>
          <li>
            <button type="button" data-open-assistant class="btn-ghost !py-1.5 !px-3 !text-xs ml-1">
              Ask my AI
            </button>
          </li>
        </ul>

        <button type="button" class="theme-toggle inline-flex md:hidden" data-theme-toggle aria-label="Toggle light and dark mode">
          <svg class="theme-icon-dark w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
          <svg class="theme-icon-light w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36 6.36l-1.42-1.42M7.05 7.05L5.64 5.64m12.72 0l-1.41 1.41M7.05 16.95l-1.41 1.41M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
          </svg>
        </button>
        <button
          id="mobile-menu-button"
          class="md:hidden text-white p-2 rounded-lg hover:bg-white/5"
          aria-label="Toggle menu"
          type="button"
        >
          <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) header?.classList.add("scrolled");
    else header?.classList.remove("scrolled");
  });

  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const navMenu = document.getElementById("nav-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  if (mobileMenuButton && navMenu) {
    mobileMenuButton.addEventListener("click", () => {
      const isHidden = navMenu.classList.contains("hidden");
      if (isHidden) {
        navMenu.classList.remove("hidden");
        navMenu.classList.add(
          "flex",
          "flex-col",
          "absolute",
          "left-4",
          "right-4",
          "top-[4.5rem]",
          "glass",
          "rounded-xl",
          "p-3",
          "gap-1"
        );
        menuIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      } else {
        navMenu.classList.add("hidden");
        navMenu.classList.remove(
          "flex",
          "flex-col",
          "absolute",
          "left-4",
          "right-4",
          "top-[4.5rem]",
          "glass",
          "rounded-xl",
          "p-3",
          "gap-1"
        );
        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      }
    });
  }
</script>
