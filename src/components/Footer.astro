---
import { siteConfig } from "../config";
---

<footer class="relative z-10 border-t border-white/10 mt-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="space-y-3">
        <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-cyan-300">Currently open to</p>
        <p class="text-white font-display text-lg">{siteConfig.openToRoles.join(" · ")}</p>
        <a href={`mailto:${siteConfig.social.email}`} class="inline-flex items-center gap-2 text-sm text-white/70 hover:text-white">
          <span class="status-dot"></span>
          Available for AI / FDE roles
        </a>
      </div>

      <nav class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm text-white/60">
        <a href="/" class="hover:text-white">Home</a>
        <a href="/about" class="hover:text-white">About</a>
        <a href="/projects" class="hover:text-white">Projects</a>
        <a href="/case-studies" class="hover:text-white">Case Studies</a>
        <a href="/lab" class="hover:text-white">AI Lab</a>
        <a href="/contact" class="hover:text-white">Contact</a>
      </nav>
    </div>

    <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-xs text-white/40 font-mono">
        © {new Date().getFullYear()} {siteConfig.name}
      </p>
      <div class="flex gap-5 text-white/50">
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-white text-sm">GitHub</a>
        )}
        {siteConfig.social.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white text-sm">LinkedIn</a>
        )}
        {siteConfig.social.email && (
          <a href={`mailto:${siteConfig.social.email}`} class="hover:text-white text-sm">Email</a>
        )}
      </div>
    </div>
  </div>
</footer>
