---
import { siteConfig } from "../config";
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <p class="section-kicker">How I build AI systems</p>
    <h2 class="font-display text-3xl sm:text-4xl mt-3 mb-8">From business problem → production AI</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {siteConfig.buildSteps.map((step) => (
        <div class="glass glass-hover rounded-xl p-4 min-h-[132px]">
          <p class="font-mono text-[11px] text-cyan-300">{step.number}</p>
          <h3 class="mt-2 text-white font-medium">{step.title}</h3>
          <p class="mt-1 text-sm text-white/55">{step.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
