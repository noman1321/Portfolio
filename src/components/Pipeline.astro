---
import { siteConfig } from "../config";
---

<section class="py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <p class="section-kicker mb-6">From idea to production</p>
    <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-0">
      {siteConfig.pipeline.map((step, index) => (
        <>
          <div class="flex-1 glass rounded-xl px-4 py-4 text-center">
            <p class="font-mono text-[10px] text-cyan-300/80 mb-1">{String(index + 1).padStart(2, "0")}</p>
            <p class="text-sm text-white">{step.label}</p>
          </div>
          {index < siteConfig.pipeline.length - 1 && (
            <div class="flow-arrow flex justify-center md:px-2 text-cyan-400/70 font-mono text-sm" aria-hidden="true">
              <span class="md:hidden">↓</span>
              <span class="hidden md:inline">→</span>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
