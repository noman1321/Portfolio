---
import { siteConfig } from "../config";
---

<section class="py-16 pb-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rounded-3xl border border-cyan-400/20 bg-cyan-400/5 p-8 sm:p-12">
      <p class="section-kicker">Let's talk</p>
      <h2 class="font-display text-3xl sm:text-5xl mt-3 max-w-xl">Have an AI problem worth solving?</h2>
      <p class="mt-4 text-white/60 max-w-xl">
        Currently open to {siteConfig.openToRoles.join(" · ")}.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${siteConfig.social.email}`} class="btn-primary">Email Me</a>
        {siteConfig.social.linkedin && (
          <a href={siteConfig.social.linkedin} class="btn-ghost" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        )}
        <a href="/resume" class="btn-ghost">Resume</a>
        <a href={siteConfig.resumeFile} class="btn-ghost" download>Download</a>
      </div>
    </div>
  </div>
</section>
