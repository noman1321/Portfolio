---
interface Props {
  slug: string;
  name: string;
  tagline: string;
  domains: string[];
  problem: string;
  solution: string;
  github?: string;
  demo?: string;
  index?: number;
}

const { slug, name, tagline, domains, problem, solution, github, demo, index } = Astro.props;
---

<article class="glass glass-hover rounded-2xl p-5 sm:p-6 flex flex-col gap-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      {typeof index === "number" && (
        <p class="font-mono text-[11px] text-cyan-300 mb-1">{String(index + 1).padStart(2, "0")} / Project</p>
      )}
      <h3 class="font-display text-xl sm:text-2xl text-white">{name}</h3>
    </div>
  </div>

  <div class="flex flex-wrap gap-1.5">
    {domains.map((domain) => (
      <span class="font-mono text-[10px] tracking-wide uppercase px-2 py-1 rounded-md border border-white/10 text-white/70">
        {domain}
      </span>
    ))}
  </div>

  <p class="text-sm sm:text-base text-white/70 leading-relaxed">{tagline}</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
    <div class="rounded-xl border border-white/10 p-3">
      <p class="font-mono text-[10px] uppercase tracking-widest text-white/40 mb-1">Problem</p>
      <p class="text-white/70">{problem}</p>
    </div>
    <div class="rounded-xl border border-white/10 p-3">
      <p class="font-mono text-[10px] uppercase tracking-widest text-white/40 mb-1">Solution</p>
      <p class="text-white/70">{solution}</p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 pt-1">
    <a href={`/projects/${slug}`} class="btn-primary !py-2">Case Study</a>
    {demo && (
      <a href={demo} class="btn-ghost !py-2" target="_blank" rel="noopener noreferrer">Play Store</a>
    )}
    {github && (
      <a href={github} class="btn-ghost !py-2" target="_blank" rel="noopener noreferrer">GitHub</a>
    )}
  </div>
</article>
