---
import { siteConfig } from "../config";
---

<section class="relative min-h-[92vh] flex items-center pt-24 pb-12 overflow-hidden">
  <div class="orb w-64 h-64 bg-cyan-400/20 top-24 left-[8%]" style="animation-delay: 0s;"></div>
  <div class="orb w-80 h-80 bg-violet-500/15 bottom-10 right-[6%]" style="animation-delay: -4s;"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full relative">
    <p class="section-kicker reveal mb-4">{siteConfig.title}</p>
    <h1 class="reveal font-display text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] leading-[1.05] tracking-tight max-w-4xl">
      {siteConfig.headline}
    </h1>
    <p class="reveal mt-5 font-mono text-sm sm:text-base text-white/60">
      {siteConfig.subheadline}
    </p>
    <p class="reveal mt-2 text-white/50 text-sm">
      {siteConfig.focusLine}
    </p>

    <div class="reveal mt-8 flex flex-wrap gap-3">
      <a href="/projects" class="btn-primary">View My Work</a>
      {siteConfig.social.github && (
        <a href={siteConfig.social.github} class="btn-ghost" target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
      {siteConfig.social.linkedin && (
        <a href={siteConfig.social.linkedin} class="btn-ghost" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
      <a href="/resume" class="btn-ghost">Resume</a>
    </div>

    <div class="reveal mt-10 grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="glass rounded-xl p-4">
        <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-white/40">Currently</p>
        <p class="mt-2 text-sm text-white">{siteConfig.currently.role}</p>
      </div>
      <div class="glass rounded-xl p-4">
        <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-white/40">Focus</p>
        <p class="mt-2 text-sm text-white">{siteConfig.currently.focus}</p>
      </div>
      <div class="glass rounded-xl p-4">
        <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-white/40">Open to</p>
        <p class="mt-2 text-sm text-white">{siteConfig.currently.openTo}</p>
      </div>
    </div>
  </div>
</section>
