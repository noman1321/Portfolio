---
import { siteConfig } from "../config";
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="section-kicker">Noman's AI Lab</p>
        <h2 class="font-display text-3xl sm:text-4xl mt-3">Experiments & notes</h2>
      </div>
      <a href="/lab" class="hidden sm:inline-flex btn-ghost">Open the lab</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {siteConfig.lab.map((item) => (
        <a href={`/lab/${item.slug}`} class="glass glass-hover rounded-2xl p-5 flex flex-col min-h-[180px]">
          <p class="font-mono text-[10px] uppercase tracking-widest text-emerald-400">{item.status}</p>
          <h3 class="mt-3 text-white font-display text-lg">{item.title}</h3>
          <p class="mt-2 text-sm text-white/55 flex-1">{item.subtitle}</p>
          <p class="mt-4 font-mono text-xs text-cyan-300">Explore →</p>
        </a>
      ))}
    </div>
  </div>
</section>
