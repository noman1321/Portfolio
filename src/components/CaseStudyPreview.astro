---
import { siteConfig } from "../config";
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="section-kicker">How I think</p>
        <h2 class="font-display text-3xl sm:text-4xl mt-3">Case studies</h2>
      </div>
      <a href="/case-studies" class="hidden sm:inline-flex btn-ghost">All case studies</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {siteConfig.caseStudies.map((study) => (
        <a href={`/case-studies/${study.slug}`} class="glass glass-hover rounded-2xl p-5 block">
          <p class="font-mono text-[11px] text-cyan-300">Case Study {study.number}</p>
          <h3 class="mt-3 text-lg text-white font-display">{study.title}</h3>
          <p class="mt-2 text-sm text-white/55 leading-relaxed">{study.summary}</p>
        </a>
      ))}
    </div>
  </div>
</section>
